{
  "name": "nova-abme",
  "version": "0.1.0",
  "description": "NOVA Abme — static engineering landing page and personal gateway.",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "build:cv": "node scripts/generate-cv.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4322",
    "preview:static": "node scripts/serve.mjs",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "playwright test --config=playwright.config.ts",
    "security:scan": "node scripts/security-scan.mjs",
    "audit:deps": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm run security:scan && npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
