---
import BaseLayout from '../layouts/BaseLayout.astro';
import { content } from '../data/i18n';

const t = content.pt.notFound;
const [titleA, titleB] = t.title.split('\n');
---

<BaseLayout lang="pt" noindex>
  <main class="not-found" id="main-content">
    <p class="not-found__code">404</p>
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{titleA}<em>{titleB}</em></h1>
    <p>{t.text}</p>
    <a class="button button-primary" href="/">{t.cta} <span aria-hidden="true">→</span></a>
  </main>
</BaseLayout>
