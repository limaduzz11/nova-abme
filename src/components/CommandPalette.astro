---
import { content, type Lang } from '../data/i18n';
import { publicLinks, whatsappLink } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].command;
const nav = content[lang].nav;
const channels = content[lang].connect.channels;
---

<dialog
  class="command-dialog"
  id="command-palette"
  role="dialog"
  aria-modal="true"
  aria-labelledby="command-title"
>
  <div class="command-dialog__header">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="command-title">{t.title}</h2>
    </div>
    <button class="icon-button" type="button" data-command-close aria-label={t.closeLabel}>
      <span aria-hidden="true">×</span>
    </button>
  </div>

  <label class="command-search">
    <span class="sr-only">{t.search}</span>
    <span aria-hidden="true">&gt;</span>
    <input
      type="search"
      data-command-search
      placeholder={t.search}
      autocomplete="off"
      spellcheck="false"
    />
  </label>

  <nav class="command-list" aria-label={t.title} data-command-list>
    <a href="#top" data-command-item data-command-label={t.home}>{t.home} <span>→</span></a>
    {
      nav.map((item) => (
        <a href={item.href} data-command-item data-command-label={item.label}>
          {item.label} <span>→</span>
        </a>
      ))
    }
    <a href={publicLinks.cv} download data-command-item data-command-label={channels.cv.label}>
      {channels.cv.label} <span>↓</span>
    </a>
    <a href={whatsappLink(lang)} target="_blank" rel="noopener noreferrer" data-command-item data-command-label={channels.whatsapp.label}>
      {channels.whatsapp.label} <span>↗</span>
    </a>
    <a href={publicLinks.linkedin} target="_blank" rel="noopener noreferrer" data-command-item data-command-label={channels.linkedin.label}>
      {channels.linkedin.label} <span>↗</span>
    </a>
    <a href={publicLinks.github} target="_blank" rel="noopener noreferrer" data-command-item data-command-label={channels.github.label}>
      {channels.github.label} <span>↗</span>
    </a>
    <a href={publicLinks.vcard} download data-command-item data-command-label={channels.vcard.label}>
      {channels.vcard.label} <span>↓</span>
    </a>
  </nav>

  <p class="command-empty" data-command-empty hidden>{t.empty}</p>
  <p class="command-hint" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd><kbd>↵</kbd><kbd>esc</kbd></p>
</dialog>
