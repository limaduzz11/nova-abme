---
import { publicLinks } from '../data/site';
---

<dialog class="command-dialog" id="command-palette" aria-labelledby="command-title">
  <div class="command-dialog__header">
    <div>
      <p class="eyebrow">NOVA ABME / EDUARDO</p>
      <h2 id="command-title">NAVEGAR_</h2>
    </div>
    <button class="icon-button" type="button" data-command-close aria-label="Fechar menu de navegação">
      <span aria-hidden="true">×</span>
    </button>
  </div>

  <label class="command-search">
    <span class="sr-only">Filtrar navegação</span>
    <span aria-hidden="true">&gt;</span>
    <input
      type="search"
      data-command-search
      placeholder="Digite um destino"
      autocomplete="off"
      spellcheck="false"
    />
  </label>

  <nav class="command-list" aria-label="Destinos do menu" data-command-list>
    <a href="#engineering" data-command-item data-command-label="Experiência">Experiência <span>→</span></a>
    <a href="#work" data-command-item data-command-label="Projetos selecionados">Projetos selecionados <span>→</span></a>
    <a href="#lab" data-command-item data-command-label="Laboratório de código aberto">Laboratório de código aberto <span>→</span></a>
    <a href="#business" data-command-item data-command-label="ELP Tecnologia">ELP Tecnologia <span>↗</span></a>
    <a href="#connect" data-command-item data-command-label="Contato e links">Contato e links <span>→</span></a>
    <a
      href={publicLinks.github}
      target="_blank"
      rel="noopener noreferrer"
      data-command-item
      data-command-label="GitHub"
    >GitHub <span>↗</span></a>
    <a
      href={publicLinks.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      data-command-item
      data-command-label="LinkedIn"
    >LinkedIn <span>↗</span></a>
  </nav>

  <p class="command-empty" data-command-empty hidden>Nenhum caminho encontrado.</p>
  <p class="command-hint"><kbd>↑</kbd><kbd>↓</kbd> mover <kbd>↵</kbd> abrir <kbd>esc</kbd> fechar</p>
</dialog>
