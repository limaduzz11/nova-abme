---
import { audienceModes, contextRoutes } from '../data/site';
---

<section class="section-shell context-section" id="context" data-section-index="02" aria-labelledby="context-title">
  <div class="section-top">
    <span class="section-code">01 / CONTEXT ROUTER</span>
    <span class="section-status">SELECT A SURFACE</span>
  </div>

  <div class="section-heading reveal">
    <p class="eyebrow">A BETTER STARTING POINT</p>
    <h2 id="context-title">WHAT BROUGHT<br />YOU HERE?</h2>
    <p>Different intent, different shortest path. The index stays the same; the route changes.</p>
  </div>

  <div class="router-layout">
    <nav class="router-options reveal" aria-label="Profile routes">
      {
        contextRoutes.map((route, index) => (
          <a
            class:list={['router-option', { 'is-active': index === 0 }]}
            href={route.href}
            data-context-option
            data-context-id={route.id}
            data-description={route.description}
            data-cta={route.cta}
            data-href={route.href}
            aria-controls="context-detail"
            data-cursor-target
          >
            <span class="router-option__number">{route.number}</span>
            <span class="router-option__label">{route.label}</span>
            <span class="router-option__arrow" aria-hidden="true">↗</span>
          </a>
        ))
      }
    </nav>

    <aside class="context-detail reveal" id="context-detail" aria-live="polite">
      <p class="micro-label">CURRENT ROUTE / SOFTWARE</p>
      <p class="context-detail__copy" data-context-copy>{contextRoutes[0].description}</p>
      <a class="text-link" href={contextRoutes[0].href} data-context-cta data-cursor-target>
        {contextRoutes[0].cta}
      </a>
    </aside>
  </div>

  <div class="audience-switcher reveal" aria-labelledby="audience-title">
    <div>
      <p class="eyebrow" id="audience-title">SELECT CONTEXT</p>
      <p class="audience-switcher__note" data-audience-note>{audienceModes[2].note}</p>
    </div>
    <div class="audience-switcher__options" role="group" aria-label="Visitor context">
      {
        audienceModes.map((mode) => (
          <button
            type="button"
            class="audience-option"
            data-audience-option={mode.id}
            data-note={mode.note}
            data-cta={mode.cta}
            data-href={mode.href}
            aria-pressed={mode.id === 'exploring' ? 'true' : 'false'}
            data-cursor-target
          >
            {mode.label}
          </button>
        ))
      }
    </div>
    <a class="audience-switcher__cta text-link" href="#lab" data-audience-cta data-cursor-target>
      Open the lab →
    </a>
  </div>
</section>
