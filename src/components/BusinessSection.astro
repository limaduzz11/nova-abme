---
import { content, type Lang } from '../data/i18n';
import { publicLinks } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].business;
---

<section class="section-shell business-section" id="business" aria-labelledby="business-title">

  <div class="section-heading reveal">
    <h2 id="business-title" set:html={t.title.replace('\n', '<br />')} />
  </div>

  <div class="engagement-grid reveal">
    <div class="engagement-card">
      <h3 class="engagement-card__title">{t.cards.role.title}</h3>
      <p class="engagement-card__desc">{t.cards.role.description}</p>
      <div class="engagement-card__footer">
        <span class="engagement-card__note">{t.cards.role.note}</span>
        <a class="button" href="#connect">
          <span>{t.cards.role.cta}</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>

    <div class="engagement-card engagement-card--featured">
      <h3 class="engagement-card__title">{t.cards.elp.title}</h3>
      <p class="engagement-card__desc">{t.cards.elp.description}</p>
      <div class="engagement-card__footer">
        <span class="engagement-card__note">{t.cards.elp.note}</span>
        <div class="engagement-actions">
          <a class="button button-primary" href={publicLinks.elp} target="_blank" rel="noopener noreferrer">
            <span>{t.cards.elp.cta}</span>
            <span aria-hidden="true">↗</span>
          </a>
          <a class="button" href={publicLinks.elpEmail} title={publicLinks.elpEmailRaw}>
            <span>{t.cards.elp.ctaEmail}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
