---
import ProjectCover from './ProjectCover.astro';
import ProjectDiagram from './ProjectDiagram.astro';
import TechIcon from './TechIcon.astro';
import { content, type Lang } from '../data/i18n';
import { projectsData, publicLinks } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].work;
---

<section class="section-shell work-section" id="work" aria-labelledby="work-title">

  <div class="work-head">
    <div class="work-heading-block">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="work-title" class="work-heading">
        {t.headingA} <em>{t.headingB}</em>
      </h2>
    </div>
    <p class="work-intro">{t.intro}</p>
  </div>

  <div class="work-controls">
    <p class="work-progress-count" aria-hidden="true">
      <span data-work-current>01</span> / <span data-work-total>{String(projectsData.length).padStart(2, '0')}</span>
    </p>
    <div class="work-progress-track" aria-hidden="true">
      <span class="work-progress-fill" data-work-fill></span>
    </div>
    <div class="work-arrows">
      <button class="work-arrow" type="button" data-work-prev aria-label={t.prevLabel}>
        <span aria-hidden="true">←</span>
      </button>
      <button class="work-arrow" type="button" data-work-next aria-label={t.nextLabel}>
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>

  <ul class="work-track" data-work-track>
    {
      projectsData.map((project) => {
        const pt = t.projects[project.id];
        return (
          <li class="work-card" data-work-card>
            <a
              class="work-card__cover"
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              data-work-cover
            >
              <ProjectCover id={project.cover} />
              <span class="sr-only">{project.displayName} — {t.linkLabel}</span>
              <span class="work-card__link" aria-hidden="true">↗</span>
            </a>

            <div class="work-card__body">
              <p class="work-card__category">{pt.category}</p>
              <h3 class="work-card__name">{project.displayName}</h3>
              <p class="work-card__title">{pt.title}</p>
              <p class="work-card__desc">{pt.description}</p>

              <dl class="work-card__metrics">
                {pt.metrics.map((metric) => (
                  <div class="work-card__metric">
                    <dt>{metric.value}</dt>
                    <dd>{metric.label}</dd>
                  </div>
                ))}
              </dl>

              <div class="work-card__stack">
                <h4>{t.toolsLabel}</h4>
                <ul class="work-card__tools">
                  {project.stack.map((tool) => (
                    <li class="work-tool" title={tool.name}>
                      <span class="work-tool__orb"><TechIcon id={tool.icon} size={18} /></span>
                      <span class="work-tool__name">{tool.name}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <details class="work-card__arch">
                <summary>{t.archLabel}</summary>
                <ProjectDiagram id={project.diagram} caption={pt.diagramCaption} />
              </details>

              <a class="work-card__repo" href={project.href} target="_blank" rel="noopener noreferrer">
                {t.linkLabel} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </li>
        );
      })
    }
  </ul>

  <div class="work-dots" data-work-dots>
    {
      projectsData.map((project) => (
        <button
          class="work-dot"
          type="button"
          data-work-dot
          data-index={project.number}
          aria-label={project.displayName}
        />
      ))
    }
  </div>

  <div class="section-end-link">
    <a class="text-link" href={publicLinks.github} target="_blank" rel="noopener noreferrer">
      {t.allRepos} <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
