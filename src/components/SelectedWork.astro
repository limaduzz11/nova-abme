---
import { projects, publicLinks } from '../data/site';
---

<section class="section-shell work-section" id="work" data-section-index="04" aria-labelledby="work-title">
  <div class="section-top">
    <span class="section-code">03 / PROJETOS</span>
    <span class="section-status">ENGENHARIA PÚBLICA & REPOSITÓRIOS</span>
  </div>

  <div class="section-heading section-heading--split reveal">
    <div>
      <p class="eyebrow">RACIOCÍNIO DE ENGENHARIA</p>
      <h2 id="work-title">PROJETOS<br />SELECIONADOS.</h2>
    </div>
    <p>O trabalho corporativo permanece privado sob sigilo de clientes; aqui, cada projeto demonstra decisões de arquitetura, qualidade de código e capacidade de entrega.</p>
  </div>

  <div class="work-list">
    {
      projects.map((project) => (
        <article
          class="project-card reveal"
          data-audience-focus={project.number === '01' || project.number === '02' ? 'hiring' : 'exploring'}
        >
          <div class="project-card__header">
            <div class="project-card__identity">
              <span class="project-card__number">{project.number}</span>
              <div>
                <span class="micro-label project-card__badge">{project.badge}</span>
                <h3 class="project-card__name">
                  <a href={project.href} target="_blank" rel="noopener noreferrer" data-cursor-target>
                    {project.name}
                  </a>
                </h3>
                <p class="project-card__subtitle">{project.title}</p>
              </div>
            </div>

            <div class="project-card__meta">
              <span class="status-pill">{project.status}</span>
              <span class="project-card__year">{project.year}</span>
            </div>
          </div>

          <div class="project-card__body">
            <div class="project-card__narrative">
              <div class="narrative-item">
                <span class="narrative-tag narrative-tag--problem">Problema</span>
                <p>{project.problem}</p>
              </div>
              <div class="narrative-item">
                <span class="narrative-tag narrative-tag--solution">Solução</span>
                <p>{project.solution}</p>
              </div>
            </div>
          </div>

          <div class="project-card__footer">
            <div class="project-card__stack">
              <span class="stack-label">Stack:</span>
              <span>{project.stack}</span>
            </div>

            <a
              class="project-card__link"
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              data-cursor-target
            >
              <span>Ver código no GitHub</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <div class="section-end-link reveal">
    <a class="text-link" href={publicLinks.github} target="_blank" rel="noopener noreferrer" data-cursor-target>
      Explorar todos os repositórios no GitHub <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
