---
import { projects, publicLinks } from '../data/site';
---

<section class="section-shell work-section" id="work" data-section-index="04" aria-labelledby="work-title">
  <div class="section-top">
    <span class="section-code">03 / PROJETOS</span>
    <span class="section-status">APENAS PROJETOS PÚBLICOS</span>
  </div>

  <div class="section-heading section-heading--split reveal">
    <div>
      <p class="eyebrow">TRABALHO REAL, SEM ENFEITE</p>
      <h2 id="work-title">PROJETOS<br />SELECIONADOS.</h2>
    </div>
    <p>Uma seleção de repositórios públicos e experimentos. O trabalho corporativo permanece privado; aqui, cada projeto mostra uma parte do que sei fazer.</p>
  </div>

  <div class="work-list">
    {
      projects.map((project) => (
        <a
          class="work-row reveal"
          href={project.href}
          target="_blank"
          rel="noopener noreferrer"
          data-audience-focus={project.number === '01' || project.number === '03' ? 'hiring' : 'exploring'}
          data-cursor-target
        >
          <span class="work-row__number">{project.number}</span>
          <div class="work-row__main">
            <p class="micro-label">{project.category}</p>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
          </div>
          <div class="work-row__meta">
            <span>{project.stack}</span>
            <span>{project.status}</span>
            <span>{project.year}</span>
          </div>
          <span class="work-row__arrow" aria-hidden="true">↗</span>
        </a>
      ))
    }
  </div>

  <div class="section-end-link reveal">
    <a class="text-link" href={publicLinks.github} target="_blank" rel="noopener noreferrer" data-cursor-target>
      Ver todos os repositórios públicos <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
