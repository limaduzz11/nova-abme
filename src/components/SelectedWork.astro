---
import { projects, publicLinks } from '../data/site';
---

<section class="section-shell work-section" id="work" aria-labelledby="work-title">

  <div class="section-heading section-heading--split reveal">
    <div>
      <p class="eyebrow">ENGENHARIA E ARQUITETURA</p>
      <h2 id="work-title">PROJETOS<br />SELECIONADOS.</h2>
    </div>
    <p>
      Além do trabalho corporativo sob sigilo de clientes, cada projeto público demonstra decisões reais de arquitetura, qualidade de código e capacidade de entrega.
    </p>
  </div>

  <div class="work-list">
    {
      projects.map((project) => (
        <article class="project-card reveal">
          <span class="project-card__number">{project.number}</span>

          <div class="project-card__main">
            <div class="project-card__header">
              <div>
                <div class="project-card__badges">
                  <span class="micro-label project-card__badge">{project.badge}</span>
                  <span class="status-pill status-pill--subtle">{project.status}</span>
                </div>
                <h3 class="project-card__name">
                  <a href={project.href} target="_blank" rel="noopener noreferrer" data-cursor-target>
                    {project.name === 'nova-hub' ? 'NOVA HUB WEB' : project.name}
                  </a>
                </h3>
                <p class="project-card__subtitle">{project.title}</p>
              </div>

              <div class="project-card__meta">
                <span class="project-card__year">{project.year}</span>
              </div>
            </div>

            <div class="project-card__body">
              <p class="project-card__description">{project.description}</p>

              {project.modules && project.modules.length > 0 && (
                <div class="project-modules">
                  <p class="project-modules__heading">Módulos Integrados do Hub</p>
                  <div class="project-modules__grid">
                    {project.modules.map((module) => (
                      <div class="project-module-card">
                        <div class="project-module-card__header">
                          <span class="module-tag">MÓDULO</span>
                          <strong class="module-title">{module.name}</strong>
                        </div>
                        <p class="module-role">{module.role}</p>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <div class="project-card__footer">
              <div class="project-card__stack">
                <span class="stack-label">Stack:</span>
                <span>{project.stack}</span>
              </div>

              <a
                class="project-card__link"
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                data-cursor-target
              >
                <span>Ver no GitHub</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="section-end-link reveal">
    <a class="text-link" href={publicLinks.github} target="_blank" rel="noopener noreferrer" data-cursor-target>
      Explorar todos os repositórios no GitHub <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
