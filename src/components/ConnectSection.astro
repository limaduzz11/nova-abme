---
import { content, type Lang } from '../data/i18n';
import { contactChannels, publicLinks, whatsappLink } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].connect;
---

<section class="section-shell connect-section" id="connect" aria-labelledby="connect-title">
  <div class="section-heading section-heading--split reveal">
    <div>
      <h2 id="connect-title" set:html={t.title.replace('\n', '<br />')} />
    </div>
    <p>
      {t.introBefore}
      <a class="inline-link" href={publicLinks.elp} target="_blank" rel="noopener noreferrer">ELP Tecnologia</a>{t.introAfter}
    </p>
  </div>

  <ul class="connect-list reveal">
    {
      contactChannels.map((channel) => {
        const txt = t.channels[channel.id];
        const href = channel.id === 'whatsapp' ? whatsappLink(lang) : channel.href;
        return (
          <li class:list={['connect-row', { 'connect-row--primary': channel.primary }]}>
            <span class="connect-row__label">{txt.label}</span>
            <span class="connect-row__detail">{txt.detail}</span>
            <span class="connect-row__actions">
              {channel.copyable && (
                <button
                  class="connect-row__copy"
                  type="button"
                  data-copy-email={publicLinks.emailRaw}
                  title={txt.label}
                >
                  <span data-copy-label>{t.copy}</span>
                </button>
              )}
              <a
                class="connect-row__action"
                href={href}
                target={channel.isExternal ? '_blank' : undefined}
                rel={channel.isExternal ? 'noopener noreferrer' : undefined}
                download={channel.download ? true : undefined}
              >
                {txt.action}
                <span aria-hidden="true">{channel.isExternal ? '↗' : '↓'}</span>
              </a>
            </span>
          </li>
        );
      })
    }
  </ul>
</section>
