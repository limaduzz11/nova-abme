---
import { publicLinks } from '../data/site';
---

<section class="section-shell connect-section" id="connect" data-section-index="07" aria-labelledby="connect-title">
  <div class="section-top">
    <span class="section-code">06 / CONNECT</span>
    <span class="section-status">DIRECT ROUTES</span>
  </div>

  <div class="connect-heading reveal">
    <p class="eyebrow">NO FORM. NO FRICTION.</p>
    <h2 id="connect-title">CHOOSE A<br /><em>DIRECT ROUTE.</em></h2>
  </div>

  <div class="connect-grid">
    <a class="connect-link reveal" href={publicLinks.github} target="_blank" rel="noopener noreferrer" data-audience-focus="hiring exploring" data-cursor-target>
      <span class="connect-link__number">01</span>
      <span>
        <strong>GitHub</strong>
        <small>Public code, patterns and experiments</small>
      </span>
      <span aria-hidden="true">↗</span>
    </a>
    <a class="connect-link reveal" href={publicLinks.linkedin} target="_blank" rel="noopener noreferrer" data-audience-focus="hiring" data-cursor-target>
      <span class="connect-link__number">02</span>
      <span>
        <strong>LinkedIn</strong>
        <small>Professional context and profile</small>
      </span>
      <span aria-hidden="true">↗</span>
    </a>
    <a class="connect-link reveal" href={publicLinks.contact} target="_blank" rel="noopener noreferrer" data-audience-focus="software" data-cursor-target>
      <span class="connect-link__number">03</span>
      <span>
        <strong>Contact</strong>
        <small>Start at the ELP Tecnologia contact route</small>
      </span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
