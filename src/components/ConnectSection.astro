---
import { contactChannels, publicLinks } from '../data/site';
---

<section class="section-shell connect-section" id="connect" aria-labelledby="connect-title">

  <div class="section-heading reveal">
    <p class="eyebrow">COMUNICAÇÃO DIRETA</p>
    <h2 id="connect-title">VAMOS<br /><em>CONVERSAR?</em></h2>
    <p class="connect-subtitle">
      Sem formulários extensos: escolha o canal mais ágil para falar sobre oportunidades, projetos ou trocar ideias técnicas.
    </p>
  </div>

  <div class="connect-grid">
    {
      contactChannels.map((channel) => (
        <div class="connect-card reveal">
          <div class="connect-card__header">
            <span class="connect-card__number">{channel.number}</span>
            <span class="micro-label connect-card__badge">{channel.badge}</span>
          </div>

          <div class="connect-card__body">
            <h3 class="connect-card__title">{channel.label}</h3>
            <p class="connect-card__detail">{channel.detail}</p>
          </div>

          <div class="connect-card__actions">
            {channel.id === 'email' ? (
              <div class="email-actions-group">
                <a
                  class="button button-primary"
                  href={channel.href}
                  data-cursor-target
                >
                  <span>Enviar e-mail ↗</span>
                </a>
                <button
                  class="button button-copy"
                  type="button"
                  data-copy-email={publicLinks.emailRaw}
                  data-cursor-target
                  title="Copiar endereço de e-mail"
                >
                  <span data-copy-label>Copiar</span>
                  <span aria-hidden="true">⧉</span>
                </button>
              </div>
            ) : (
              <a
                class:list={['button', { 'button-primary': channel.id === 'whatsapp' || channel.id === 'cv' }]}
                href={channel.href}
                target={channel.isExternal ? '_blank' : undefined}
                rel={channel.isExternal ? 'noopener noreferrer' : undefined}
                download={channel.download ? true : undefined}
                data-cursor-target
              >
                <span>{channel.actionText}</span>
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>
