---
import { content, type Lang } from '../data/i18n';
import { publicLinks, siteMeta, whatsappLink } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].footer;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <p class="footer-name">{siteMeta.name.toUpperCase()}</p>
      <p class="footer-role">{t.role}</p>
      <p class="footer-meta">{t.location} · {siteMeta.year}</p>
    </div>

    <nav class="footer-links" aria-label={t.quickLinks}>
      <a href={publicLinks.cv} download>{content[lang].connect.channels.cv.label} ↓</a>
      <a href={publicLinks.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      <a href={publicLinks.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href={whatsappLink(lang)} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
      <a href={publicLinks.elp} target="_blank" rel="noopener noreferrer">ELP Tecnologia ↗</a>
    </nav>
  </div>
</footer>
