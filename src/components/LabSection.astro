---
import { content, type Lang } from '../data/i18n';
import { labItems, publicLinks } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].lab;
---

<section class="section-shell lab-section" id="lab" aria-labelledby="lab-title">

  <div class="lab-layout">
    <div class="lab-header reveal">
      <div class="lab-badge-row">
        <span class="lab-mark" aria-hidden="true">VANTA LABZ</span>
        <span class="micro-label">{t.eyebrow}</span>
      </div>

      <h2 id="lab-title" set:html={t.title.replace('\n', '<br />')} />
      <p class="lab-desc">{t.intro}</p>
    </div>

    <ul class="lab-list reveal">
      {
        labItems.map((item) => {
          const pt = t.items[item.id];
          return (
            <li class:list={['lab-row', { 'lab-row--concept': item.maturity === 'concept' }]}>
              <div class="lab-row__meta">
                <span class="lab-row__status">{pt.badge}</span>
                <h3 class="lab-row__name">{pt.name}</h3>
              </div>
              <p class="lab-row__desc">{pt.description}</p>
            </li>
          );
        })
      }
    </ul>

    <div class="lab-actions reveal">
      <a class="button button-primary" href={publicLinks.github} target="_blank" rel="noopener noreferrer">
        <span>{t.action}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
