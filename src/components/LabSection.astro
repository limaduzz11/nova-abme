---
import { publicLinks, workDirectories } from '../data/site';
---

<section class="section-shell lab-section" id="lab" data-section-index="05" aria-labelledby="lab-title">
  <div class="section-top">
    <span class="section-code">04 / LABORATÓRIO / CÓDIGO ABERTO</span>
    <span class="section-status">VANTA LABZ</span>
  </div>

  <div class="lab-layout">
    <div class="lab-identity reveal">
      <p class="lab-identity__mark" aria-hidden="true">VANTA<br />LABZ</p>
      <p class="micro-label">LOCAL EM PRIMEIRO LUGAR / EXPERIMENTOS</p>
    </div>
    <div class="lab-copy reveal">
      <p class="eyebrow">UM ESPAÇO PARA TESTAR IDEIAS</p>
      <h2 id="lab-title">IDEIAS QUE<br /><em>PODEM IR</em><br />MAIS LONGE.</h2>
      <p>VANTA Labz reúne ferramentas, leituras e experimentos de código aberto feitos perto de quem usa.</p>
      <a class="text-link" href={publicLinks.github} target="_blank" rel="noopener noreferrer" data-cursor-target>
        Ver trabalhos públicos no GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="lab-directory reveal" aria-label="Diretórios de trabalho público">
      <p class="terminal-line"><span aria-hidden="true">~/eduardo $</span> ls ./trabalho</p>
      <ul>
        {
          workDirectories.map((directory) => <li>{directory}</li>)
        }
      </ul>
      <p class="terminal-line terminal-line--muted">trabalho público → github.com/limaduzz11</p>
    </div>
  </div>
</section>
