---
import { publicLinks, vantaProjects } from '../data/site';

const activeVanta = vantaProjects.filter((project) => project.maturity === 'active');
const conceptVanta = vantaProjects.filter((project) => project.maturity === 'concept');
---

<section class="section-shell lab-section" id="lab" aria-labelledby="lab-title">

  <div class="lab-layout">
    <div class="lab-header reveal">
      <div class="lab-badge-row">
        <span class="lab-mark" aria-hidden="true">VANTA LABZ</span>
        <span class="micro-label">CÓDIGO ABERTO & AUTONOMIA LOCAL</span>
      </div>

      <h2 id="lab-title">FERRAMENTAS QUE<br /><em>AMPLIAM A</em> AUTONOMIA.</h2>
      <p class="lab-desc">
        VANTA Labz é o selo dedicado a projetos pessoais, ferramentas de produtividade e utilitários de código aberto desenvolvidos com princípios offline-first, foco em privacidade e controle local de dados.
      </p>
    </div>

    <div class="vanta-cards-grid reveal">
      {
        activeVanta.map((item) => (
          <div class="vanta-card">
            <div class="vanta-card__header">
              <span class="micro-label vanta-card__badge">{item.badge}</span>
              {item.role && <span class="micro-label vanta-card__role">{item.role}</span>}
            </div>
            <h3 class="vanta-card__name">{item.name}</h3>
            <p class="vanta-card__desc">{item.description}</p>
          </div>
        ))
      }
    </div>

    {
      conceptVanta.length > 0 && (
        <div class="vanta-concepts reveal">
          <p class="micro-label vanta-concepts__label">Conceitos em laboratório</p>
          <div class="vanta-cards-grid vanta-cards-grid--concept">
            {conceptVanta.map((item) => (
              <div class="vanta-card">
                <div class="vanta-card__header">
                  <span class="micro-label vanta-card__badge">{item.badge}</span>
                </div>
                <h3 class="vanta-card__name">{item.name}</h3>
                <p class="vanta-card__desc">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <div class="lab-actions reveal">
      <a class="button button-primary" href={publicLinks.github} target="_blank" rel="noopener noreferrer" data-cursor-target>
        <span>Ver ecossistema no GitHub</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
