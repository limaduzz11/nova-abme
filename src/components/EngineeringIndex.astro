---
import TechStack from './TechStack.astro';
import { content, type Lang } from '../data/i18n';
import { publicLinks } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].engineering;
const tr = content[lang].trajectory;
---

<section class="section-shell engineering-section" id="engineering" aria-labelledby="engineering-title">
  <div class="section-heading section-heading--wide reveal">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 id="engineering-title" set:html={t.title.replace('\n', '<br />')} />
    <p>{t.intro}</p>
  </div>

  <!-- Tablist de Especialidades -->
  <div class="engineering-grid">
    <div class="stack-index reveal">
      <p class="index-heading">{t.stackHeading}</p>
      <div class="stack-list" role="tablist" aria-label={t.stackHeading}>
        {
          t.stack.map((item, index) => (
            <button
              type="button"
              role="tab"
              class="stack-item"
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls="stack-detail"
              data-stack-option
              data-stack-id={item.number}
              data-number={item.number}
              data-title={item.title}
              data-context={item.context}
              data-label={item.label}
              data-highlights={item.highlights.join(' · ')}
            >
              <span>{item.number}</span>
              <strong>{item.label}</strong>
              <span aria-hidden="true">+</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="stack-detail reveal" id="stack-detail" role="tabpanel" aria-live="polite">
      <p class="micro-label" data-stack-context>{t.stack[0].context}</p>
      <p class="stack-detail__code" data-stack-code>{t.stack[0].number} / {t.stack[0].label}</p>
      <h3 data-stack-title>{t.stack[0].title}</h3>

      <div class="stack-detail__highlights">
        <span class="highlights-label">{t.topicsLabel}</span>
        <p class="highlights-content" data-stack-highlights>{t.stack[0].highlights.join(' · ')}</p>
      </div>
    </div>
  </div>

  <!-- Minhas Tecnologias (stack & ferramentas) -->
  <TechStack lang={lang} />

  <!-- Trajetória Profissional (dados verificáveis do CV) -->
  <div class="trajectory-block reveal" id="trajectory">
    <div class="trajectory-header">
      <div>
        <p class="eyebrow">{tr.eyebrow}</p>
        <h3 class="trajectory-title">{tr.title}</h3>
      </div>
    </div>

    <ol class="trajectory-list">
      {
        tr.items.map((item) => (
          <li class:list={['trajectory-item', { 'is-current': item.current }]}>
            <p class="trajectory-period">{item.period}</p>
            <div class="trajectory-body">
              <p class="trajectory-role">
                {item.role} <span>· {item.company}</span>
              </p>
              <ul class="trajectory-highlights">
                {item.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <!-- Bloco de Resultados no Mundo Real -->
  <div class="results-block reveal" id="results">
    <div class="results-header">
      <div>
        <p class="eyebrow">{t.results.eyebrow}</p>
        <h3 class="results-title">{t.results.title}</h3>
      </div>
      <p class="results-confidentiality">{t.results.note}</p>
    </div>

    <div class="results-grid">
      {
        t.results.items.map((result) => (
          <div class="result-card">
            <div class="result-card__metric">{result.metric}</div>
            <h4 class="result-card__title">{result.title}</h4>
            <p class="result-card__description">{result.description}</p>
          </div>
        ))
      }
    </div>

    <div class="results-cta">
      <span>{t.results.ctaQuestion}</span>
      <a class="text-link" href={publicLinks.cv} download>
        {t.results.ctaLink} ↓
      </a>
    </div>
  </div>
</section>
