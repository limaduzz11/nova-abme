---
import { navItems, publicLinks } from '../data/site';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="#top" title="Ir para o início">
      <span class="brand__mark" aria-hidden="true">EP</span>
      <span class="brand__text">
        <span class="brand__name">EDUARDO PARANHOS</span>
        <span class="brand__role">TOTVS PROTHEUS & ADVPL</span>
      </span>
    </a>


    <nav class="primary-nav" aria-label="Navegação principal">
      {
        navItems.map((item) => (
          <a href={item.href} data-cursor-target>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a
        class="header-cv-link"
        href={publicLinks.cv}
        download
        data-cursor-target
        title="Baixar Currículo em PDF"
      >
        <span>CV (PDF)</span>
        <span aria-hidden="true">↓</span>
      </a>

      <button
        class="command-trigger"
        type="button"
        data-command-open
        aria-controls="command-palette"
        aria-haspopup="dialog"
        aria-keyshortcuts="Control+K"
        data-cursor-target
      >
        <span class="command-trigger__label">Menu</span>
        <kbd>Ctrl K</kbd>
      </button>
    </div>
  </div>
</header>
