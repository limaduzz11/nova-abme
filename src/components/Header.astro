---
import LangSwitch from './LangSwitch.astro';
import { content, type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="#top" title="Eduardo Paranhos">
      <span class="brand__mark" aria-hidden="true">EP</span>
      <span class="brand__text">
        <span class="brand__name">EDUARDO PARANHOS</span>
        <span class="brand__role">TOTVS PROTHEUS &amp; ADVPL</span>
      </span>
    </a>

    <div class="header-actions">
      <LangSwitch lang={lang} />

      <button
        class="command-trigger"
        type="button"
        data-command-open
        aria-controls="command-palette"
        aria-haspopup="dialog"
        aria-keyshortcuts="Control+K"
        aria-label={t.command.menuLabel}
      >
        <span class="command-trigger__label">Menu</span>
        <kbd aria-hidden="true">Ctrl K</kbd>
      </button>
    </div>
  </div>
</header>
