---
import { publicLinks, siteMeta } from '../data/site';
---

<section class="hero section-shell" id="top" data-section-index="01" aria-labelledby="hero-title">
  <div class="section-top">
    <span class="section-code">00 / INÍCIO</span>
    <span class="section-status">NOVA ABME / PERFIL 001</span>
  </div>

  <div class="hero-grid">
    <div class="hero-copy reveal">
      <p class="eyebrow">EDUARDO DE LIMA PARANHOS / DESENVOLVIMENTO DE SOFTWARE</p>
      <h1 id="hero-title">
        <span>SOFTWARE</span>
        <span>QUE FUNCIONA</span>
        <span>NO <em>MUNDO REAL.</em></span>
      </h1>
      <p class="hero-lede">
        Desenvolvedor de software com experiência em ERP, integrações, automação e produtos digitais.
      </p>

      <div class="hero-actions" aria-label="Caminhos principais">
        <a class="button button-primary" href={publicLinks.linkedin} target="_blank" rel="noopener noreferrer" data-cursor-target>
          Ver perfil no LinkedIn <span aria-hidden="true">↗</span>
        </a>
        <a class="button" href="#work" data-cursor-target>
          Ver projetos <span aria-hidden="true">→</span>
        </a>
        <a class="button button-text" href="#connect" data-cursor-target>
          Falar comigo <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <aside class="hero-aside reveal" aria-label="Resumo do perfil">
      <div class="hero-aside__top">
        <span class="micro-label">EDP / 001</span>
        <span class="signal-dot" aria-hidden="true"></span>
      </div>
      <p class="hero-aside__title">Um resumo rápido da experiência, dos projetos e dos caminhos para falar comigo.</p>
      <dl class="signal-list">
        <div>
          <dt>Foco</dt>
          <dd>Software e ERP</dd>
        </div>
        <div>
          <dt>Experiência</dt>
          <dd>Integrações e automação</dd>
        </div>
        <div>
          <dt>Contato</dt>
          <dd>Direto e simples</dd>
        </div>
      </dl>
      <p class="hero-aside__foot">NOVA ABME / {siteMeta.profileSlug}</p>
    </aside>
  </div>

  <a class="scroll-cue" href="#context" data-cursor-target>
    <span>Role para conhecer o trabalho</span>
    <span aria-hidden="true">↓</span>
  </a>
</section>
