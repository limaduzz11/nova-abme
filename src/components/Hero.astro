---
import { publicLinks, siteMeta } from '../data/site';
---

<section class="hero section-shell" id="top" data-section-index="01" aria-labelledby="hero-title">
  <div class="section-top">
    <span class="section-code">00 / INÍCIO</span>
    <span class="section-status">PERFIL PROFISSIONAL · TOTVS PROTHEUS</span>
  </div>

  <div class="hero-grid">
    <div class="hero-copy reveal">
      <div class="hero-tag-row">
        <p class="eyebrow">EDUARDO DE LIMA PARANHOS · SOFTWARE DEVELOPER</p>
      </div>

      <h1 id="hero-title">
        <span>SOFTWARE</span>
        <span>QUE FUNCIONA</span>
        <span>NO <em>MUNDO REAL.</em></span>
      </h1>

      <p class="hero-lede">
        Desenvolvedor especialista em <strong>TOTVS Protheus</strong>, <strong>ADVPL / TL++</strong>, <strong>APIs REST</strong> e <strong>SQL Server</strong>. Criação de integrações de alta confiabilidade, regras de negócio em Faturamento, Financeiro e Estoque, e automação corporativa.
      </p>

      <div class="hero-actions" aria-label="Caminhos principais de conversão">
        <a class="button button-primary" href={publicLinks.cv} download data-cursor-target>
          <span>Baixar Currículo (PDF)</span>
          <span aria-hidden="true">↓</span>
        </a>

        <a class="button" href={publicLinks.linkedin} target="_blank" rel="noopener noreferrer" data-cursor-target>
          <span>LinkedIn</span>
          <span aria-hidden="true">↗</span>
        </a>

        <a class="button" href={publicLinks.whatsapp} target="_blank" rel="noopener noreferrer" data-cursor-target>
          <span>WhatsApp</span>
          <span aria-hidden="true">↗</span>
        </a>

        <button
          class="button button-copy"
          type="button"
          data-copy-email={publicLinks.emailRaw}
          data-cursor-target
          title="Clique para copiar o e-mail"
        >
          <span data-copy-label>Copiar E-mail</span>
          <span class="copy-icon" aria-hidden="true">⧉</span>
        </button>

        <a class="button button-text" href="#work" data-cursor-target>
          <span>Ver projetos</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <aside class="hero-aside reveal" aria-label="Resumo rápido do perfil para triagem técnica">
      <div class="hero-aside__top">
        <span class="micro-label">RESUMO TÉCNICO</span>
        <span class="signal-dot" aria-hidden="true"></span>
      </div>
      <p class="hero-aside__title">Desenvolvimento focado em estabilidade de processos e dados no ERP.</p>
      <dl class="signal-list">
        <div>
          <dt>Especialidade</dt>
          <dd>TOTVS Protheus · ADVPL / TL++</dd>
        </div>
        <div>
          <dt>Módulos</dt>
          <dd>FAT · FIN · EST · COM</dd>
        </div>
        <div>
          <dt>Integrações</dt>
          <dd>APIs REST · SOAP · Marketplaces</dd>
        </div>
        <div>
          <dt>Banco</dt>
          <dd>SQL Server & T-SQL</dd>
        </div>
        <div>
          <dt>Atuação</dt>
          <dd>São Paulo & Remoto (GMT-3)</dd>
        </div>
      </dl>
      <p class="hero-aside__foot">São Paulo · Brasil · {siteMeta.year}</p>
    </aside>
  </div>

  <a class="scroll-cue" href="#engineering" data-cursor-target>
    <span>Role para explorar experiência, projetos e código</span>
    <span aria-hidden="true">↓</span>
  </a>
</section>
