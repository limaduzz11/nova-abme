---
import { content, type Lang } from '../data/i18n';
import { publicLinks, whatsappLink } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang].hero;
---

<section class="hero section-shell" id="top" aria-labelledby="hero-title">
  <div class="hero-grid">
    <div class="hero-copy reveal">
      <p class="eyebrow">{t.eyebrow}</p>

      <h1 id="hero-title">
        <span>{content[lang].heroTitle[0]}</span>
        <span>{content[lang].heroTitle[1]}</span>
        <span><em>{content[lang].heroTitle[2]}</em></span>
      </h1>

      <p class="hero-lede">{t.lede}</p>

      <div class="hero-actions" role="group" aria-label={t.actionsLabel}>
        <a class="button button-primary" href={publicLinks.cv} download>
          <span>{t.ctaCv}</span>
          <span aria-hidden="true">↓</span>
        </a>

        <a class="button" href={publicLinks.linkedin} target="_blank" rel="noopener noreferrer">
          <span>{t.ctaLinkedin}</span>
          <span aria-hidden="true">↗</span>
        </a>

        <a class="button" href={whatsappLink(lang)} target="_blank" rel="noopener noreferrer">
          <span>{t.ctaWhatsapp}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <a class="hero-projects" href="#work">
        <span>{t.projectsLink}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <a class="scroll-cue" href="#engineering">
    <span>{t.scroll}</span>
    <span aria-hidden="true">↓</span>
  </a>
</section>
