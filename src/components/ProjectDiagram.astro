---
/**
 * Diagramas de arquitetura "blueprint" — SVG inline por projeto.
 * Fonte de verdade: READMEs dos repositórios vinculados. Sem dados internos.
 */
interface Props {
  id: 'hub' | 'research' | 'rest-lab' | 'po-ui';
  caption: string;
}

const { id, caption } = Astro.props;
---

<figure class="project-diagram">
  <div class="project-diagram__viewport" tabindex="0" role="region" aria-label={`Diagrama de arquitetura — ${caption}`}>
  {
    id === 'hub' && (
      <svg viewBox="0 0 760 180" role="img" aria-label="Arquitetura do NOVA HUB: navegador, serviços Express com terminal PTY e sistema Linux, conectados em malha privada Tailscale.">
        <defs>
          <marker id="dg-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,0 L8,4 L0,8 z" fill="currentColor" />
          </marker>
        </defs>
        <g class="dg-box">
          <rect x="16" y="26" width="180" height="88" />
          <rect x="270" y="26" width="220" height="88" />
          <rect x="564" y="26" width="180" height="88" />
        </g>
        <g class="dg-title">
          <text x="30" y="48">BROWSER</text>
          <text x="284" y="48">HOST · SERVIÇOS</text>
          <text x="578" y="48">SISTEMA</text>
        </g>
        <g class="dg-item">
          <text x="30" y="70">Vanilla JS (ES6)</text>
          <text x="30" y="88">xterm.js 6</text>
          <text x="30" y="106">CSS "Midnight Navy"</text>
          <text x="284" y="70">Express 5 API · REST</text>
          <text x="284" y="88">node-pty + ws (terminal)</text>
          <text x="284" y="106">Sessão + guard CSRF</text>
          <text x="578" y="70">Linux · systemd</text>
          <text x="578" y="88">sensores de hardware</text>
          <text x="578" y="106">OpenSSH (chave)</text>
        </g>
        <g class="dg-edge">
          <path d="M196 52 H270" />
          <path d="M196 88 H270" />
          <path d="M490 52 H564" />
          <path d="M490 88 H564" />
        </g>
        <g class="dg-label">
          <text x="206" y="46">HTTP/REST</text>
          <text x="206" y="82">WebSocket (PTY)</text>
          <text x="504" y="46">forkpty</text>
          <text x="504" y="82">sinais</text>
        </g>
        <path class="dg-mesh" d="M106 150 H654" />
        <text class="dg-mesh-label" x="380" y="168" text-anchor="middle">MALHA PRIVADA TAILSCALE · SEM EXPOSIÇÃO PÚBLICA</text>
      </svg>
    )
  }

  {
    id === 'research' && (
      <svg viewBox="0 0 760 132" role="img" aria-label="Arquitetura do protheus-research: cliente MCP consulta o servidor TypeScript que indexa conhecimento do ecossistema Protheus.">
        <g class="dg-box">
          <rect x="16" y="22" width="200" height="80" />
          <rect x="280" y="22" width="200" height="80" />
          <rect x="544" y="22" width="200" height="80" />
        </g>
        <g class="dg-title">
          <text x="30" y="44">AGENTE / DEV</text>
          <text x="294" y="44">MCP SERVER (TS)</text>
          <text x="558" y="44">BASE INDEXADA</text>
        </g>
        <g class="dg-item">
          <text x="30" y="66">cliente MCP</text>
          <text x="30" y="84">consultas técnicas</text>
          <text x="294" y="66">ferramentas de consulta</text>
          <text x="294" y="84">diagnóstico de erros</text>
          <text x="558" y="66">sintaxe ADVPL/TL++</text>
          <text x="558" y="84">rotinas · tabelas · regras</text>
        </g>
        <g class="dg-edge">
          <path d="M216 62 H280" />
          <path d="M480 62 H544" />
        </g>
        <g class="dg-label">
          <text x="224" y="56">MCP / stdio</text>
          <text x="488" y="56">índice local</text>
        </g>
      </svg>
    )
  }

  {
    id === 'rest-lab' && (
      <svg viewBox="0 0 760 154" role="img" aria-label="Arquitetura do protheus-rest-lab: cliente consome WSRESTFUL em ADVPL que responde com envelope JSON e status HTTP, persistindo no banco do Protheus.">
        <g class="dg-box">
          <rect x="16" y="26" width="190" height="84" />
          <rect x="274" y="26" width="230" height="84" />
          <rect x="572" y="26" width="172" height="84" />
        </g>
        <g class="dg-title">
          <text x="30" y="48">CLIENTE</text>
          <text x="288" y="48">PROTHEUS · REST</text>
          <text x="586" y="48">DADOS</text>
        </g>
        <g class="dg-item">
          <text x="30" y="70">HTTP + JSON</text>
          <text x="30" y="88">GET/POST/PUT/DELETE</text>
          <text x="288" y="70">WSRESTFUL + WSMETHOD</text>
          <text x="288" y="88">envelope + status HTTP</text>
          <text x="586" y="70">tabelas do ERP</text>
          <text x="586" y="88">persistência</text>
        </g>
        <g class="dg-edge">
          <path d="M206 52 H274" />
          <path d="M274 86 H206" />
          <path d="M504 69 H572" />
        </g>
        <g class="dg-label">
          <text x="216" y="46">request</text>
          <text x="216" y="100">response</text>
          <text x="514" y="63">DBAccess</text>
        </g>
        <text class="dg-mesh-label" x="380" y="142" text-anchor="middle">PAGINAÇÃO · CÓDIGOS HTTP · TRATAMENTO DE EXCEÇÕES</text>
      </svg>
    )
  }

  {
    id === 'po-ui' && (
      <svg viewBox="0 0 760 132" role="img" aria-label="Arquitetura do protheus-po-ui-template: portal Angular com PO-UI consome APIs REST do Protheus para telas de consulta e operação.">
        <g class="dg-box">
          <rect x="16" y="22" width="220" height="80" />
          <rect x="310" y="22" width="190" height="80" />
          <rect x="574" y="22" width="170" height="80" />
        </g>
        <g class="dg-title">
          <text x="30" y="44">PORTAL ANGULAR</text>
          <text x="324" y="44">REST API</text>
          <text x="588" y="44">PROTHEUS</text>
        </g>
        <g class="dg-item">
          <text x="30" y="66">design system PO-UI</text>
          <text x="30" y="84">telas + componentes TOTVS</text>
          <text x="324" y="66">consumo HTTP/JSON</text>
          <text x="324" y="84">contratos tipados</text>
          <text x="588" y="66">rotinas ADVPL</text>
          <text x="588" y="84">consultas e operação</text>
        </g>
        <g class="dg-edge">
          <path d="M236 62 H310" />
          <path d="M500 62 H574" />
        </g>
        <g class="dg-label">
          <text x="248" y="56">REST/JSON</text>
          <text x="516" y="56">ADVPL</text>
        </g>
      </svg>
    )
  }
  </div>
  <figcaption>{caption}</figcaption>
</figure>
