---
/**
 * Diagramas de arquitetura "blueprint" — SVG inline por projeto.
 * Labels em inglês técnico (padrão de engenharia, neutro entre idiomas);
 * legenda traduzida via prop `caption`.
 */
interface Props {
  id: 'hub' | 'research' | 'rest-lab' | 'po-ui';
  caption: string;
}

const { id, caption } = Astro.props;
---

<figure class="project-diagram">
  <div class="project-diagram__viewport" tabindex="0" role="region" aria-label={`${caption}`}>
  {
    id === 'hub' && (
      <svg viewBox="0 0 760 180" role="img" aria-label="NOVA HUB architecture: browser, Express services with PTY terminal and Linux system over a private Tailscale mesh.">
        <defs>
          <marker id="dg-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,0 L8,4 L0,8 z" fill="currentColor" />
          </marker>
        </defs>
        <g class="dg-box">
          <rect x="16" y="26" width="180" height="88" />
          <rect x="270" y="26" width="220" height="88" />
          <rect x="564" y="26" width="180" height="88" />
        </g>
        <g class="dg-title">
          <text x="30" y="48">BROWSER</text>
          <text x="284" y="48">HOST · SERVICES</text>
          <text x="578" y="48">SYSTEM</text>
        </g>
        <g class="dg-item">
          <text x="30" y="70">Vanilla JS (ES6)</text>
          <text x="30" y="88">xterm.js 6</text>
          <text x="30" y="106">CSS "Midnight Navy"</text>
          <text x="284" y="70">Express 5 API · REST</text>
          <text x="284" y="88">node-pty + ws (terminal)</text>
          <text x="284" y="106">Session + CSRF guard</text>
          <text x="578" y="70">Linux · systemd</text>
          <text x="578" y="88">hardware sensors</text>
          <text x="578" y="106">OpenSSH (key)</text>
        </g>
        <g class="dg-edge">
          <path d="M196 52 H270" />
          <path d="M196 88 H270" />
          <path d="M490 52 H564" />
          <path d="M490 88 H564" />
        </g>
        <g class="dg-label">
          <text x="206" y="46">HTTP/REST</text>
          <text x="206" y="82">WebSocket (PTY)</text>
          <text x="504" y="46">forkpty</text>
          <text x="504" y="82">signals</text>
        </g>
        <path class="dg-mesh" d="M106 150 H654" />
        <text class="dg-mesh-label" x="380" y="168" text-anchor="middle">PRIVATE TAILSCALE MESH · NO PUBLIC EXPOSURE</text>
      </svg>
    )
  }

  {
    id === 'research' && (
      <svg viewBox="0 0 760 132" role="img" aria-label="protheus-research architecture: MCP client queries a TypeScript server indexing Protheus ecosystem knowledge.">
        <g class="dg-box">
          <rect x="16" y="22" width="200" height="80" />
          <rect x="280" y="22" width="200" height="80" />
          <rect x="544" y="22" width="200" height="80" />
        </g>
        <g class="dg-title">
          <text x="30" y="44">AGENT / DEV</text>
          <text x="294" y="44">MCP SERVER (TS)</text>
          <text x="558" y="44">INDEXED BASE</text>
        </g>
        <g class="dg-item">
          <text x="30" y="66">MCP client</text>
          <text x="30" y="84">technical queries</text>
          <text x="294" y="66">query tools</text>
          <text x="294" y="84">error diagnostics</text>
          <text x="558" y="66">ADVPL/TL++ syntax</text>
          <text x="558" y="84">routines · tables · rules</text>
        </g>
        <g class="dg-edge">
          <path d="M216 62 H280" />
          <path d="M480 62 H544" />
        </g>
        <g class="dg-label">
          <text x="224" y="56">MCP / stdio</text>
          <text x="488" y="56">local index</text>
        </g>
      </svg>
    )
  }

  {
    id === 'rest-lab' && (
      <svg viewBox="0 0 760 154" role="img" aria-label="protheus-rest-lab architecture: HTTP client consumes WSRESTFUL in ADVPL that replies with a JSON envelope and HTTP status, persisting to the ERP database.">
        <g class="dg-box">
          <rect x="16" y="26" width="190" height="84" />
          <rect x="274" y="26" width="230" height="84" />
          <rect x="572" y="26" width="172" height="84" />
        </g>
        <g class="dg-title">
          <text x="30" y="48">CLIENT</text>
          <text x="288" y="48">PROTHEUS · REST</text>
          <text x="586" y="48">DATA</text>
        </g>
        <g class="dg-item">
          <text x="30" y="70">HTTP + JSON</text>
          <text x="30" y="88">GET/POST/PUT/DELETE</text>
          <text x="288" y="70">WSRESTFUL + WSMETHOD</text>
          <text x="288" y="88">envelope + HTTP status</text>
          <text x="586" y="70">ERP tables</text>
          <text x="586" y="88">persistence</text>
        </g>
        <g class="dg-edge">
          <path d="M206 52 H274" />
          <path d="M274 86 H206" />
          <path d="M504 69 H572" />
        </g>
        <g class="dg-label">
          <text x="216" y="46">request</text>
          <text x="216" y="100">response</text>
          <text x="514" y="63">DBAccess</text>
        </g>
        <text class="dg-mesh-label" x="380" y="142" text-anchor="middle">PAGINATION · HTTP STATUS · EXCEPTION HANDLING</text>
      </svg>
    )
  }

  {
    id === 'po-ui' && (
      <svg viewBox="0 0 760 132" role="img" aria-label="protheus-po-ui-template architecture: Angular portal with PO-UI consuming Protheus REST APIs for query and operation screens.">
        <g class="dg-box">
          <rect x="16" y="22" width="220" height="80" />
          <rect x="310" y="22" width="190" height="80" />
          <rect x="574" y="22" width="170" height="80" />
        </g>
        <g class="dg-title">
          <text x="30" y="44">ANGULAR PORTAL</text>
          <text x="324" y="44">REST API</text>
          <text x="588" y="44">PROTHEUS</text>
        </g>
        <g class="dg-item">
          <text x="30" y="66">PO-UI design system</text>
          <text x="30" y="84">TOTVS screens + components</text>
          <text x="324" y="66">HTTP/JSON consumption</text>
          <text x="324" y="84">typed contracts</text>
          <text x="588" y="66">ADVPL routines</text>
          <text x="588" y="84">queries and operation</text>
        </g>
        <g class="dg-edge">
          <path d="M236 62 H310" />
          <path d="M500 62 H574" />
        </g>
        <g class="dg-label">
          <text x="248" y="56">REST/JSON</text>
          <text x="516" y="56">ADVPL</text>
        </g>
      </svg>
    )
  }
  </div>
  <figcaption>{caption}</figcaption>
</figure>
